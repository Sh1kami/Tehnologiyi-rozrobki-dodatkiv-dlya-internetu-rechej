{
  "name": "fleet-watch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/start.js",
    "demo": "node src/demo.js",
    "test": "node --test --test-concurrency=1",
    "coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=src/domain.js",
    "build": "vite build",
    "lint": "eslint .",
    "coverage:src": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=src/server.js --test-coverage-include=src/domain.js --test-coverage-include=src/geofence.js --test-coverage-lines=80 --test-coverage-branches=70",
    "e2e": "playwright test"
  },
  "dependencies": {
    "aedes": "0.51.3",
    "bcryptjs": "3.0.2",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "leaflet": "1.9.4",
    "mqtt": "5.14.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@stryker-mutator/core": "9.6.1",
    "eslint": "9.39.1",
    "fast-check": "4.3.0",
    "vite": "6.4.6"
  }
}
